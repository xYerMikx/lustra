{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd
	root * /srv/landing

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

app.{$DOMAIN} {
	encode gzip zstd
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	encode gzip zstd
	reverse_proxy api:3333
}
