# Required for `astro build` / preview / production.
# Optional in `astro dev` (falls back to http://localhost:3000).
PUBLIC_APP_URL=http://localhost:3000

# Public analytics (baked at build). Leave empty locally — banner stays hidden.
# Create the Metrika counter at https://metrika.yandex.ru (tag for lumira.by).
# Create GA4 at https://analytics.google.com (Measurement ID G-…).
PUBLIC_YANDEX_METRIKA_ID=
PUBLIC_GA_MEASUREMENT_ID=
# Optional Google Search Console meta token if you do not use a domain TXT.
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Session replay (Вебвизор). Keep off on pages with forms; 1/true to enable.
PUBLIC_YANDEX_METRIKA_WEBVISOR=
