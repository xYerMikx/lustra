---
import '../styles/global.css'
import AnalyticsConsent from '@/components/analytics-consent.astro'
import SiteFooter from '@/components/site-footer.astro'
import SiteHeader from '@/components/site-header.astro'
import { getLandingGoogleSiteVerification } from '@/lib/analytics'
import { FONT_PRELOADS } from '@/lib/font-preloads'
import { ogImageForPath } from '@/lib/og-pages'
import {
  DEFAULT_DESCRIPTION,
  OG_IMAGE,
  SITE_NAME,
  absoluteUrl,
} from '@/lib/seo'

interface Props {
  title: string
  description?: string
  canonicalPath?: string
  ogType?: string
  ogImagePath?: string
  ogImageAlt?: string
  noindex?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  ogImagePath: ogImagePathProp,
  ogImageAlt: ogImageAltProp,
  noindex = false,
  jsonLd,
} = Astro.props

const pageOg = ogImageForPath(canonicalPath)
const ogImagePath = ogImagePathProp ?? pageOg.path
const ogImageAlt = ogImageAltProp ?? pageOg.alt

const siteOrigin = Astro.site?.href?.replace(/\/$/, '') ?? 'https://lumira.by'
const path =
  canonicalPath === '/'
    ? '/'
    : canonicalPath.replace(/\/$/, '') || '/'
const canonical =
  path === '/' ? `${siteOrigin}/` : `${siteOrigin}${path}/`
const ogImage = absoluteUrl(ogImagePath)
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : []

const googleVerification = getLandingGoogleSiteVerification()
---

<!doctype html>
<html lang="ru-BY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="author" content={SITE_NAME} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="theme-color" content="#faf7f4" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="yandex-verification" content="850dcfa6d6439521" />
    {
      googleVerification && (
        <meta name="google-site-verification" content={googleVerification} />
      )
    }
    <link rel="canonical" href={canonical} />
    {
      FONT_PRELOADS.map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
        />
      ))
    }
    <link rel="alternate" hreflang="ru-BY" href={canonical} />
    <link rel="alternate" hreflang="ru" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ru_BY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={OG_IMAGE.type} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      jsonLdBlocks.map((block) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block)}
        />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <AnalyticsConsent />
  </body>
</html>
