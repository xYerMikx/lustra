---
import { getCollection, getEntry } from 'astro:content'
import BaseLayout from '../layouts/base-layout.astro'
import Hero from '../components/hero.astro'
import HowItWorks from '../components/how-it-works.astro'
import WorksMarquee from '../components/works-marquee.astro'
import ComparisonTable from '../components/comparison-table.astro'
import CategoriesDistricts from '../components/categories-districts.astro'
import FaqSection from '../components/faq-section.astro'
import CtaBand from '../components/cta-band.astro'
import { SHOW_WORKS_PREVIEW } from '../lib/flags'
import { getAppUrl } from '../lib/site'

const hero = (await getEntry('sections', 'hero'))!.data
const how = (await getEntry('sections', 'how-it-works'))!.data
const works = SHOW_WORKS_PREVIEW
  ? (await getEntry('sections', 'works'))!.data
  : null
const comparison = (await getEntry('sections', 'comparison'))!.data
const browse = (await getEntry('sections', 'browse'))!.data
const cta = (await getEntry('sections', 'cta'))!.data

const faqEntries = (await getCollection('faq')).sort(
  (a, b) => a.data.order - b.data.order,
)

const faqItems = faqEntries.map((entry) => ({
  question: entry.data.question,
  answer: (entry.body ?? '').trim(),
}))

const catalogHref = getAppUrl('/catalog')
const masterHref = getAppUrl('/app/register?role=master&utm_source=landing')

const categories = (browse.categories ?? []).map((item) => ({
  name: item.name,
  href: getAppUrl(`/catalog/${item.slug}`),
}))

const districts = (browse.districts ?? []).map((item) => ({
  name: item.name,
  href: getAppUrl(`/catalog?district=${item.slug}`),
}))
---

<BaseLayout
  title="Lumira — бьюти-мастера Минска"
  description="Lumira — агрегатор бьюти-мастеров в Минске. Найдите мастера и запишитесь онлайн."
>
  <main>
    <Hero
      brand={hero.brand!}
      headline={hero.headline!}
      lead={hero.lead!}
      primaryCta={hero.primaryCta!}
      secondaryCta={hero.secondaryCta!}
      catalogHref={catalogHref}
      masterHref={masterHref}
    />

    <HowItWorks
      eyebrow={how.eyebrow!}
      title={how.title!}
      lead={how.lead!}
      clientSteps={how.clientSteps!}
      masterSteps={how.masterSteps!}
    />

    {works && (
      <WorksMarquee
        eyebrow={works.eyebrow!}
        title={works.title!}
        lead={works.lead!}
        works={works.works!}
      />
    )}

    <ComparisonTable
      eyebrow={comparison.eyebrow!}
      title={comparison.title!}
      lead={comparison.lead!}
      rows={comparison.rows!}
    />

    <CategoriesDistricts
      eyebrow={browse.eyebrow!}
      title={browse.title!}
      lead={browse.lead!}
      categories={categories}
      districts={districts}
    />

    <FaqSection items={faqItems} />

    <CtaBand
      title={cta.title!}
      lead={cta.lead!}
      primaryCta={cta.primaryCta!}
      secondaryCta={cta.secondaryCta!}
      catalogHref={catalogHref}
      masterHref={masterHref}
    />
  </main>
</BaseLayout>
