---
import { getEntry } from 'astro:content'
import BaseLayout from '../layouts/base-layout.astro'
import LegalStub from '../components/legal-stub.astro'

const content = (await getEntry('sections', 'terms'))!.data
---

<BaseLayout
  title="Пользовательское соглашение · Lumira"
  description="Условия использования платформы Lumira."
  canonicalPath="/terms"
>
  <LegalStub
    title={content.title!}
    lead={content.lead}
    paragraphs={content.body ?? []}
  />
</BaseLayout>
