---
import { getEntry } from 'astro:content'
import BaseLayout from '@/layouts/base-layout.astro'
import ServicesCatalog from '@/components/services-catalog.astro'
import { getAppUrl } from '@/lib/site'
import {
  catalogHrefForService,
  groupServicesByCategory,
} from '@/lib/service-catalog'
import { breadcrumbJsonLd, webPageJsonLd } from '@/lib/seo'

const copy = (await getEntry('sections', 'services'))!.data
const browse = (await getEntry('sections', 'browse'))!.data
const catalogHref = getAppUrl('/catalog')

const groups = groupServicesByCategory(browse.categories ?? []).map((group) => ({
  name: group.name,
  slug: group.slug,
  categoryHref: getAppUrl(`/catalog/${group.slug}`),
  services: group.services.map((service) => ({
    title: service.title,
    href: catalogHrefForService(getAppUrl, group.slug, service.title),
  })),
}))

const title = 'Все бьюти-услуги в Минске и Беларуси — каталог · Lumira'
const description =
  'Полный каталог бьюти-услуг Lumira: ногти, брови, волосы, макияж, косметология, депиляция, массаж, тату и пирсинг. Найдите мастера в Минске и запишитесь онлайн.'

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: copy.title,
  description: copy.lead,
  itemListElement: groups
    .flatMap((group) =>
      group.services.map((service) => ({
        '@type': 'ListItem',
        name: service.title,
        url: service.href,
      })),
    )
    .map((item, index) => ({
      ...item,
      position: index + 1,
    })),
}
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/services"
  jsonLd={[
    itemListJsonLd,
    webPageJsonLd({ title, description, path: '/services' }),
    breadcrumbJsonLd([
      { name: 'Lumira', path: '/' },
      { name: 'Все услуги', path: '/services' },
    ]),
  ]}
>
  <ServicesCatalog
    eyebrow={copy.eyebrow!}
    title={copy.title!}
    lead={copy.lead!}
    catalogCta={copy.primaryCta!}
    catalogHref={catalogHref}
    emptyMessage={copy.emptyMessage!}
    groups={groups}
  />
</BaseLayout>
