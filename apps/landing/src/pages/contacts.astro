---
import { getEntry } from 'astro:content'
import BaseLayout from '@/layouts/base-layout.astro'
import ContactsPage from '@/components/contacts-page.astro'

const content = (await getEntry('sections', 'contacts'))!.data
---

<BaseLayout
  title="Контакты и поддержка · Lumira"
  description="Свяжитесь с поддержкой Lumira: support@lumira.by. Реквизиты оператора платформы в Минске, Республика Беларусь."
  canonicalPath="/contacts"
>
  <ContactsPage
    title={content.title!}
    lead={content.lead}
    notes={content.body ?? []}
  />
</BaseLayout>
