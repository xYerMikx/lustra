---
import { getEntry } from 'astro:content'
import BaseLayout from '../layouts/base-layout.astro'
import LegalStub from '../components/legal-stub.astro'

const content = (await getEntry('sections', 'contacts'))!.data
---

<BaseLayout
  title="Контакты · Lumira"
  description="Контакты команды Lumira — поддержка и партнёрство."
  canonicalPath="/contacts"
>
  <LegalStub
    title={content.title!}
    lead={content.lead}
    paragraphs={content.body ?? []}
  />
</BaseLayout>
