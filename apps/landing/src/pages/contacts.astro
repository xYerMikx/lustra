---
import { getEntry } from 'astro:content'
import BaseLayout from '@/layouts/base-layout.astro'
import ContactsPage from '@/components/contacts-page.astro'

const content = (await getEntry('sections', 'contacts'))!.data
---

<BaseLayout
  title="Контакты · Lumira"
  description="Контакты оператора Lumira — поддержка и реквизиты физического лица."
  canonicalPath="/contacts"
>
  <ContactsPage
    title={content.title!}
    lead={content.lead}
    notes={content.body ?? []}
  />
</BaseLayout>
