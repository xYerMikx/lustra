---
import { getEntry } from 'astro:content'
import BaseLayout from '../layouts/base-layout.astro'
import LegalStub from '../components/legal-stub.astro'

const content = (await getEntry('sections', 'privacy'))!.data
---

<BaseLayout
  title="Политика конфиденциальности · Lumira"
  description="Политика конфиденциальности Lumira — обработка персональных данных."
  canonicalPath="/privacy"
>
  <LegalStub
    title={content.title!}
    lead={content.lead}
    paragraphs={content.body ?? []}
  />
</BaseLayout>
