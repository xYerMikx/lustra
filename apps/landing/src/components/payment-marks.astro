---
import { PAYMENT_MARKS } from '@/lib/payment-marks'
---

<ul class="ribbon" aria-label="Способы оплаты">
  {
    PAYMENT_MARKS.map((mark) => (
      <li class="item">
        <img
          class="logo"
          src={mark.src}
          alt={mark.alt}
          height="32"
          loading="lazy"
          decoding="async"
        />
      </li>
    ))
  }
</ul>

<style>
  .ribbon {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-16) var(--spacing-20);
  }

  .item {
    display: flex;
    align-items: center;
    min-height: var(--spacing-40);
  }

  .logo {
    display: block;
    width: auto;
    height: auto;
    max-height: var(--spacing-32);
    max-width: var(--spacing-80);
    object-fit: contain;
  }
</style>
