---
import { getLandingAnalyticsConfig } from '@/lib/analytics'

const analytics = getLandingAnalyticsConfig()
---

{
  analytics.enabled && (
    <div
      id="lumira-analytics-banner"
      class="banner"
      hidden
      role="dialog"
      aria-labelledby="lumira-analytics-title"
      aria-describedby="lumira-analytics-text"
    >
      <div class="copy">
        <p class="title" id="lumira-analytics-title">Счётчики посещений</p>
        <p class="text" id="lumira-analytics-text">
          Чтобы понимать, откуда приходят гости, мы можем включить Яндекс.Метрику
          и Google Analytics. Они ставят cookie и передают технические данные
          визита обработчикам, в том числе Google в США.{' '}
          <a class="link" href="/privacy/#cookies">Подробнее в политике</a>
          . Можно отказаться: для просмотра сайта это не обязательно.
        </p>
      </div>
      <div class="actions">
        <button class="btn btn-secondary" type="button" id="lumira-analytics-deny">
          Только необходимые
        </button>
        <button class="btn btn-primary" type="button" id="lumira-analytics-accept">
          Принять
        </button>
      </div>
    </div>
  )
}

{
  analytics.enabled && (
    <script>
      import { bootLandingAnalytics } from '@/lib/boot-analytics'

      bootLandingAnalytics()
    </script>
  )
}

<style>
  .banner {
    position: fixed;
    z-index: var(--z-40);
    right: var(--spacing-16);
    bottom: max(var(--spacing-16), env(safe-area-inset-bottom));
    left: var(--spacing-16);
    display: none;
    gap: var(--spacing-16);
    padding: var(--spacing-20);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-14);
    background: var(--color-surface);
    box-shadow: var(--shadow-2);
    color: var(--color-text);
  }

  .banner.is-open {
    display: grid;
  }

  .copy {
    display: grid;
    gap: var(--spacing-8);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-20);
    line-height: var(--text-20--line-height);
  }

  .text {
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--text-13);
    line-height: var(--text-13--line-height);
  }

  .link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-8);
    justify-content: flex-end;
  }

  @media (min-width: 768px) {
    .banner {
      left: auto;
      width: min(32rem, calc(100% - var(--spacing-32)));
    }
  }
</style>
