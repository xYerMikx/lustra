---
import PaymentMarks from '@/components/payment-marks.astro'
import { isNavCurrent } from '@/lib/nav-current'
import { PLATFORM_OPERATOR } from '@/lib/operator'

interface Props {
  year?: number
}

const year = Astro.props.year ?? new Date().getFullYear()
const mailto = `mailto:${PLATFORM_OPERATOR.supportEmail}`
const path = Astro.url.pathname
const productLinks = [
  { href: '/', label: 'Главная' },
  { href: '/services/', label: 'Все услуги' },
  { href: '/for-masters/', label: 'Для мастеров' },
  { href: '/#faq', label: 'FAQ' },
]
const companyLinks = [
  { href: '/contacts/', label: 'Реквизиты' },
  { href: '/payment/', label: 'Оплата и возврат' },
  { href: '/terms/', label: 'Публичная оферта' },
  { href: '/privacy/', label: 'Политика конфиденциальности' },
]
---

<footer class="site-footer">
  <div class="inner">
    <div class="brand-col">
      <p class="brand">Lumira</p>
      <p class="tag">Бьюти-мастера Минска и Беларуси — запись без хаоса.</p>
    </div>

    <nav class="cols" aria-label="Подвал">
      <div class="col">
        <p class="col-title">Продукт</p>
        {
          productLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isNavCurrent(path, link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="col">
        <p class="col-title">Компания</p>
        {
          companyLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isNavCurrent(path, link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="col facts">
        <p class="col-title">Контакты</p>
        <a href={mailto}>{PLATFORM_OPERATOR.supportEmail}</a>
        <p>Телефон: {PLATFORM_OPERATOR.phone}</p>
        <p>{PLATFORM_OPERATOR.postalAddress}</p>
        <p>{PLATFORM_OPERATOR.hours}</p>
        <p>
          Оператор: {PLATFORM_OPERATOR.legalStatus}
          {' '}
          {PLATFORM_OPERATOR.fullName}
        </p>
        <p>УНП {PLATFORM_OPERATOR.unp}</p>
        <p>Дата регистрации: {PLATFORM_OPERATOR.registeredOn}</p>
        <p>{PLATFORM_OPERATOR.registeredBy}</p>
      </div>
    </nav>
  </div>

  <div class="bottom">
    <PaymentMarks />
    <p class="copy">© {year} Lumira</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: var(--spacing-32) 0 var(--spacing-32);
  }

  .inner {
    width: min(1120px, calc(100% - var(--spacing-40)));
    margin-inline: auto;
    display: grid;
    gap: var(--spacing-40);
    grid-template-columns: 1.1fr 2fr;
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--text-32);
    line-height: 1;
    margin-bottom: var(--spacing-12);
  }

  .tag {
    color: var(--color-text-2);
    max-width: 28ch;
    line-height: 1.5;
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: var(--spacing-24);
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }

  .facts {
    gap: var(--spacing-8);
  }

  .col .col-title {
    font-size: var(--text-13);
    line-height: var(--text-13--line-height);
    color: var(--color-text-3);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--spacing-4);
  }

  .col a,
  .col p {
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--text-15);
    line-height: var(--text-15--line-height);
  }

  .col a:hover {
    color: var(--color-accent);
  }

  .col a[aria-current='page'] {
    color: var(--color-text);
    font-weight: var(--font-weight-600);
  }

  .bottom {
    width: min(1120px, calc(100% - var(--spacing-40)));
    margin: var(--spacing-40) auto 0;
    padding-top: var(--spacing-24);
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--spacing-24);
  }

  .copy {
    margin: 0;
    font-size: var(--text-13);
    line-height: var(--text-13--line-height);
    color: var(--color-text-3);
  }

  @media (min-width: 961px) {
    .site-footer {
      padding: var(--spacing-64) 0 var(--spacing-40);
    }
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-32);
    }

    .cols {
      grid-template-columns: 1fr 1fr;
    }

    .facts {
      grid-column: 1 / -1;
    }

    .bottom {
      margin-top: var(--spacing-24);
    }
  }

  @media (max-width: 640px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
