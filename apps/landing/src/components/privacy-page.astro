---
import PrivacySection from '@/components/privacy-section.astro'
import type { PrivacyDocumentData } from '@/lib/privacy-policy'

interface Props {
  document: PrivacyDocumentData
}

const { document } = Astro.props
---

<main class="privacy">
  <a class="back" href="/">← На главную</a>
  <h1 class="title">{document.title}</h1>
  <p class="meta">{document.updatedLabel} · {document.operatorLine}</p>
  <p class="lead">{document.lead}</p>
  <p class="notice">{document.notice}</p>

  <nav class="toc" aria-label="Содержание политики">
    <p class="toc-title">Содержание</p>
    <ol class="toc-list">
      {
        document.sections.map((section) => (
          <li class="toc-item">
            <a class="toc-link" href={`#${section.id}`}>
              {section.title}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="sections">
    {document.sections.map((section) => <PrivacySection section={section} />)}
  </div>
</main>

<style>
  .privacy {
    width: min(800px, calc(100% - var(--spacing-40)));
    margin-inline: auto;
    padding: var(--spacing-40) 0 var(--spacing-96);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: var(--spacing-40);
    margin-bottom: var(--spacing-16);
    font-size: var(--text-13);
    line-height: var(--text-13--line-height);
    color: var(--color-text-2);
  }

  .back:hover {
    color: var(--color-accent);
  }

  .title {
    font-size: clamp(var(--text-32), 6vw, var(--text-40));
    line-height: 1.15;
    margin-bottom: var(--spacing-16);
  }

  .meta {
    color: var(--color-text-3);
    font-size: var(--text-13);
    line-height: var(--text-13--line-height);
    margin-bottom: var(--spacing-16);
  }

  .lead {
    color: var(--color-text-2);
    margin-bottom: var(--spacing-16);
    line-height: 1.55;
  }

  .notice {
    color: var(--color-text-2);
    line-height: 1.55;
    padding: var(--spacing-16);
    margin-bottom: var(--spacing-32);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-8);
  }

  .toc {
    margin-bottom: var(--spacing-40);
  }

  .toc-title {
    font-size: var(--text-13);
    line-height: var(--text-13--line-height);
    color: var(--color-text-3);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--spacing-12);
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--spacing-4);
  }

  .toc-link {
    display: flex;
    align-items: center;
    min-height: var(--spacing-40);
    color: var(--color-text-2);
    font-size: var(--text-15);
    line-height: var(--text-15--line-height);
  }

  .toc-link:hover {
    color: var(--color-accent);
  }

  .sections {
    display: grid;
    gap: var(--spacing-32);
  }
</style>
