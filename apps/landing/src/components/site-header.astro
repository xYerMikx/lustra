---
import { SHOW_WORKS_PREVIEW } from '@/lib/flags'
import { isNavCurrent } from '@/lib/nav-current'
import { getAppUrl } from '@/lib/site'

interface Props {
  catalogHref?: string
  masterHref?: string
}

const catalogHref = Astro.props.catalogHref ?? getAppUrl('/catalog')
const masterHref =
  Astro.props.masterHref ??
  getAppUrl('/app/register?role=master&utm_source=landing')
const path = Astro.url.pathname

const links = [
  { href: '/#how', label: 'Как работает' },
  ...(SHOW_WORKS_PREVIEW ? [{ href: '/#works', label: 'Работы' }] : []),
  { href: '/#browse', label: 'Категории' },
  { href: '/services/', label: 'Все услуги' },
  { href: '/for-masters/', label: 'Мастерам' },
  { href: '/payment/', label: 'Оплата' },
  { href: '/contacts/', label: 'Контакты' },
  { href: catalogHref, label: 'Каталог' },
]
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href="/">Lumira</a>

    <button
      type="button"
      class="nav-burger"
      id="nav-burger"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Открыть меню"
    >
      <span class="nav-burger-bar"></span>
      <span class="nav-burger-bar"></span>
    </button>

    <nav class="nav" id="site-nav" data-open="false" aria-label="Основная навигация">
      {
        links.map((link) => {
          const current = isNavCurrent(path, link.href)

          return (
            <a href={link.href} aria-current={current ? 'page' : undefined}>
              {link.label}
            </a>
          )
        })
      }
      <a class="nav-cta" href={masterHref}>Я мастер</a>
    </nav>
  </div>
</header>

<script>
  const burger = document.getElementById('nav-burger')
  const nav = document.getElementById('site-nav')

  if (burger instanceof HTMLButtonElement && nav instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      nav.dataset.open = open ? 'true' : 'false'
      burger.setAttribute('aria-expanded', open ? 'true' : 'false')
      burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню')
      burger.classList.toggle('is-open', open)
    }

    burger.addEventListener('click', () => {
      setOpen(nav.dataset.open !== 'true')
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || nav.dataset.open !== 'true') {
        return
      }

      setOpen(false)
      burger.focus()
    })

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (nav.dataset.open === 'true') {
          setOpen(false)
        }
      })
    })
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-40);
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .inner {
    position: relative;
    width: min(1120px, calc(100% - var(--spacing-40)));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--spacing-56);
    gap: var(--spacing-16);
  }

  .logo {
    font-family: var(--font-display);
    font-size: var(--text-26);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .nav-burger {
    display: none;
    position: relative;
    width: var(--spacing-40);
    height: var(--spacing-40);
    cursor: pointer;
    border: 0;
    border-radius: var(--radius-8);
    background: transparent;
    padding: 0;
  }

  .nav-burger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: var(--spacing-4);
  }

  .nav-burger-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--spacing-24);
    height: var(--spacing-2);
    background: var(--color-text);
    transition: transform var(--duration-250) var(--ease-out-quart);
  }

  .nav-burger-bar:first-child {
    transform: translate(-50%, calc(-50% - var(--spacing-4)));
  }

  .nav-burger-bar:last-child {
    transform: translate(-50%, calc(-50% + var(--spacing-4)));
  }

  .nav-burger.is-open .nav-burger-bar:first-child {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .nav-burger.is-open .nav-burger-bar:last-child {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-burger-bar {
      transition: none;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-16) var(--spacing-20);
    font-size: var(--text-15);
    line-height: var(--text-15--line-height);
    color: var(--color-text-2);
  }

  .nav a:hover {
    color: var(--color-accent);
  }

  .nav a[aria-current='page'] {
    color: var(--color-text);
    font-weight: var(--font-weight-600);
    box-shadow: inset 0 calc(-1 * var(--spacing-2)) 0 var(--color-accent);
  }

  .nav-cta {
    color: var(--color-accent);
    font-weight: var(--font-weight-600);
  }

  @media (max-width: 860px) {
    .nav-burger {
      display: block;
    }

    .nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      padding: var(--spacing-16) var(--spacing-20) var(--spacing-24);
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-2);
    }

    .nav[data-open='true'] {
      display: flex;
    }

    .nav a[aria-current='page'] {
      box-shadow: none;
      border-left: var(--spacing-2) solid var(--color-accent);
      padding-left: var(--spacing-12);
    }
  }
</style>
