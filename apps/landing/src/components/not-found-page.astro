---
import { getAppUrl } from '@/lib/site'

interface Props {
  catalogHref?: string
}

const catalogHref = Astro.props.catalogHref ?? getAppUrl('/catalog')
---

<main class="not-found">
  <p class="kicker">404</p>
  <h1>Страница не найдена</h1>
  <p class="lead">
    Такой страницы нет. Проверьте адрес или вернитесь на главную.
  </p>
  <div class="actions">
    <a class="btn btn-primary" href="/">На главную</a>
    <a class="btn btn-secondary" href={catalogHref}>Каталог</a>
  </div>
</main>

<style>
  .not-found {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: min(720px, calc(100% - var(--spacing-40)));
    margin-inline: auto;
    padding: var(--spacing-40) 0 var(--spacing-96);
    text-align: center;
  }

  .kicker {
    font-family: var(--font-display);
    font-size: var(--text-56);
    line-height: var(--text-56--line-height);
    font-weight: var(--font-weight-500);
    color: var(--color-text);
  }

  h1 {
    margin-top: var(--spacing-16);
    font-size: var(--text-32);
    line-height: var(--text-32--line-height);
  }

  .lead {
    max-width: calc(var(--spacing-96) * 4);
    margin-top: var(--spacing-16);
    color: var(--color-text-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-12);
    margin-top: var(--spacing-32);
  }

  @media (max-width: 639px) {
    .kicker {
      font-size: var(--text-40);
      line-height: var(--text-40--line-height);
    }

    h1 {
      font-size: var(--text-26);
      line-height: var(--text-26--line-height);
    }
  }
</style>
