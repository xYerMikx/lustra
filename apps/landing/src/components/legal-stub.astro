---
interface Props {
  title: string
  lead?: string
  paragraphs: string[]
}

const { title, lead, paragraphs } = Astro.props
---

<main class="legal">
  <a class="back" href="/">← Lumira</a>
  <h1>{title}</h1>
  {lead ? <p class="lead">{lead}</p> : null}
  <div class="body">
    {paragraphs.map((text) => <p>{text}</p>)}
  </div>
</main>

<style>
  .legal {
    width: min(720px, calc(100% - var(--spacing-40)));
    margin-inline: auto;
    padding: var(--spacing-40) 0 var(--spacing-96);
  }

  .back {
    display: inline-block;
    margin-bottom: var(--spacing-32);
    font-size: var(--text-13);
    line-height: var(--text-13--line-height);
    color: var(--color-text-2);
  }

  .back:hover {
    color: var(--color-accent);
  }

  h1 {
    font-size: clamp(var(--text-32), 6vw, var(--text-40));
    line-height: 1.15;
    margin-bottom: var(--spacing-16);
  }

  .lead {
    color: var(--color-text-2);
    margin-bottom: var(--spacing-32);
    line-height: 1.55;
  }

  .body {
    display: grid;
    gap: var(--spacing-16);
  }

  .body p {
    color: var(--color-text-2);
    line-height: 1.6;
  }
</style>
