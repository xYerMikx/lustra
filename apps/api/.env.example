NODE_ENV=development
PORT=3333

DATABASE_URL="postgresql://lumira:lumira@localhost:5432/lumira_dev?schema=public"
DIRECT_URL="postgresql://lumira:lumira@localhost:5432/lumira_dev?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# Admin hard-gate (comma-separated). Empty = allow in dev, deny all in production.
ADMIN_IP_ALLOWLIST=""

# Bootstrap admin (never via /auth/register). Run: pnpm --filter @lumira/api ensure-admin
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

TELEGRAM_BOT_TOKEN=""
# Bot username without @ (deep link https://t.me/<username>?start=<nonce>)
TELEGRAM_BOT_USERNAME=""
# Random secret in webhook URL: POST $PUBLIC_API_URL/telegram/webhook/$TELEGRAM_WEBHOOK_SECRET
# Register after the API is public:
#   curl -sS -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d "url=$PUBLIC_API_URL/telegram/webhook/$TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_WEBHOOK_SECRET=""

# Local MinIO (`make up`). Production: real bucket.
# Leave STORAGE_ENDPOINT empty for AWS S3; set it for MinIO / Timeweb / R2.
STORAGE_ENDPOINT="http://127.0.0.1:9000"
STORAGE_KEY="lumira"
STORAGE_SECRET="lumira-minio"
STORAGE_BUCKET="lumira-media"
STORAGE_REGION="us-east-1"
PUBLIC_API_URL="http://localhost:3333"
PUBLIC_APP_URL="http://localhost:3000"
# Hosted landing origin for email images (not localhost — clients cannot load it).
PUBLIC_SITE_URL="https://lumira.by"

RESEND_API_KEY=""
RESEND_FROM="Lumira <noreply@lumira.by>"

CORS_ORIGINS="http://localhost:4321,http://localhost:3000"

SENTRY_DSN=""
