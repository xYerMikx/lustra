NODE_ENV=development
PORT=3333

DATABASE_URL="postgresql://lustra:lustra@localhost:5432/lustra_dev?schema=public"
DIRECT_URL="postgresql://lustra:lustra@localhost:5432/lustra_dev?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# Admin hard-gate (comma-separated). Empty = allow in dev, deny all in production.
ADMIN_IP_ALLOWLIST=""

# Bootstrap admin (never via /auth/register). Run: pnpm --filter @lustra/api ensure-admin
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Local MinIO (`make up`). Production: real bucket.
# Leave STORAGE_ENDPOINT empty for AWS S3; set it for MinIO / Timeweb / R2.
STORAGE_ENDPOINT="http://127.0.0.1:9000"
STORAGE_KEY="lustra"
STORAGE_SECRET="lustra-minio"
STORAGE_BUCKET="lustra-media"
STORAGE_REGION="us-east-1"
PUBLIC_API_URL="http://localhost:3333"
PUBLIC_APP_URL="http://localhost:3000"

RESEND_API_KEY=""
RESEND_FROM="Lustra <noreply@lustra.by>"

CORS_ORIGINS="http://localhost:4321,http://localhost:3000"

SENTRY_DSN=""
