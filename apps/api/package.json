    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.3.0",
    "argon2": "^0.41.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
