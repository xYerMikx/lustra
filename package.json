{
  "name": "lustra",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@lustra/api",
    "dev:web": "turbo run dev --filter=@lustra/web",
    "dev:landing": "turbo run dev --filter=@lustra/landing",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @lustra/db generate",
    "db:migrate": "pnpm --filter @lustra/db migrate",
    "db:migrate:deploy": "pnpm --filter @lustra/db migrate:deploy",
    "db:seed": "pnpm --filter @lustra/db seed",
    "db:studio": "pnpm --filter @lustra/db studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
