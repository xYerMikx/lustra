# Copy to repo-root `.env.production` on the VPS (gitignored, chmod 600).
# There is no Hetzner/Cloudflare dashboard for these values.
#
# Flow now: scp / nano on the server, then `make prod-up`.
# Later: GitHub Actions Environment secrets → write this file in CI → ssh deploy.
# Never commit the filled file. Never put JWT/DB passwords in Dockerfiles.
#
# `docker compose -f deploy/docker-compose.yml --env-file .env.production`

NODE_ENV=production
DOMAIN=lumira.by
ACME_EMAIL=you@example.com

# Hetzner CX33 (HEL1) is the intended size: 4 vCPU / 8 GB / 80 GB.

POSTGRES_USER=lustra
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=lustra

DATABASE_URL=postgresql://lustra:change-me-long-random@postgres:5432/lustra?schema=public
DIRECT_URL=postgresql://lustra:change-me-long-random@postgres:5432/lustra?schema=public

REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379

JWT_ACCESS_SECRET=change-me-access-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-at-least-32-chars

COOKIE_DOMAIN=.lumira.by
PUBLIC_API_URL=https://api.lumira.by
PUBLIC_APP_URL=https://app.lumira.by
PUBLIC_SITE_URL=https://lumira.by
CORS_ORIGINS=https://lumira.by,https://www.lumira.by,https://app.lumira.by

# Your public IP, comma-separated. Empty in production = admin routes denied.
ADMIN_IP_ALLOWLIST=

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

PORT=3333

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare R2 (S3 API). Leave STORAGE_ENDPOINT empty only for AWS.
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=lumira-media
STORAGE_REGION=auto

RESEND_API_KEY=
RESEND_FROM=Lumira <noreply@lumira.by>

SENTRY_DSN=

# Baked into web/landing images at `docker compose build` time:
NEXT_PUBLIC_API_URL=https://api.lumira.by
PUBLIC_APP_URL_BUILD=https://app.lumira.by
